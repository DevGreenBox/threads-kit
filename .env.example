# Скопируйте этот файл в .env и подставьте свои значения.
# .env в репозиторий НЕ попадает (он в .gitignore) — это защита от утечки токена.

# Токен доступа к Threads API. Как его получить — в docs/getting-started.md
THREADS_ACCESS_TOKEN=

# Ваш числовой идентификатор пользователя Threads (узнаётся запросом /me)
THREADS_USER_ID=
